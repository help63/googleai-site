"use client";

import { useEffect, useMemo, useState } from "react";
import Link from "next/link";

const categories = ["All", "Men", "Women", "Kids", "Winter", "Summer", "Casual", "Sports"];

export default function GarmentsPage() {
  const [garments, setGarments] = useState([]);
  const [loading, setLoading] = useState(true);
  const [activeCategory, setActiveCategory] = useState("All");
  const [search, setSearch] = useState("");

  useEffect(() => {
    fetch("/api/content?type=garment", {
      cache: "no-store",
    })
      .then((res) => res.json())
      .then((data) => {
        setGarments(data.items || []);
      })
      .catch(() => {
        setGarments([]);
      })
      .finally(() => {
        setLoading(false);
      });
  }, []);

  const filteredGarments = useMemo(() => {
    return garments.filter((item) => {
      const text =
        `${item.title || ""} ${item.description || ""}`.toLowerCase();

      const matchesSearch = text.includes(search.toLowerCase());

      if (activeCategory === "All") {
        return matchesSearch;
      }

      return (
        matchesSearch &&
        text.includes(activeCategory.toLowerCase())
      );
    });
  }, [garments, activeCategory, search]);

  return (
    <main
      style={{
        minHeight: "100vh",
        background: "#eef2f7",
        color: "#1f2937",
        paddingBottom: 50,
      }}
    >
      {/* HERO */}
      <section
        style={{
          background:
            "linear-gradient(115deg,#1d1238 0%,#10182d 55%,#391337 100%)",
          color: "#fff",
          padding: "42px 18px",
          borderBottom: "1px solid rgba(255,255,255,.12)",
        }}
      >
        <div
          style={{
            maxWidth: 1250,
            margin: "auto",
          }}
        >
          <Link
            href="/"
            style={{
              color: "#f9a8d4",
              textDecoration: "none",
              fontWeight: 800,
              fontSize: 15,
            }}
          >
            ← Back to Home
          </Link>

          <div
            style={{
              marginTop: 24,
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center",
              gap: 20,
              flexWrap: "wrap",
            }}
          >
            <div>
              <h1
                style={{
                  fontSize: "clamp(38px,6vw,68px)",
                  margin: 0,
                  lineHeight: 1.1,
                }}
              >
                👕 Garments
              </h1>

              <p
                style={{
                  margin: "12px 0 0",
                  fontSize: 18,
                  color: "#cbd5e1",
                }}
              >
                Premium quality clothing at unbeatable prices!
              </p>
            </div>

            <div
              style={{
                background: "rgba(236,72,153,.18)",
                border: "1px solid rgba(236,72,153,.6)",
                padding: "16px 22px",
                borderRadius: 16,
                fontWeight: 900,
                color: "#fce7f3",
              }}
            >
              🛍️ Best Fashion
              <br />
              Best Prices
            </div>
          </div>
        </div>
      </section>

      {/* CONTENT */}
      <section
        style={{
          maxWidth: 1250,
          margin: "auto",
          padding: "28px 18px 60px",
        }}
      >
        {/* SEARCH */}
        <div
          style={{
            display: "flex",
            gap: 12,
            flexWrap: "wrap",
            marginBottom: 20,
          }}
        >
          <input
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            placeholder="🔍 Search garments..."
            style={{
              flex: "1 1 260px",
              minHeight: 48,
              borderRadius: 14,
              border: "1px solid #cbd5e1",
              padding: "0 16px",
              fontSize: 16,
              outline: "none",
              background: "#fff",
            }}
          />
        </div>

        {/* CATEGORIES */}
        <div
          style={{
            display: "flex",
            gap: 10,
            flexWrap: "wrap",
            marginBottom: 28,
          }}
        >
          {categories.map((category) => {
            const active = activeCategory === category;

            return (
              <button
                key={category}
                onClick={() => setActiveCategory(category)}
                style={{
                  border: active
                    ? "1px solid #db2777"
                    : "1px solid #d1d5db",
                  background: active ? "#db2777" : "#fff",
                  color: active ? "#fff" : "#374151",
                  borderRadius: 999,
                  padding: "10px 20px",
                  fontWeight: 800,
                  cursor: "pointer",
                  fontSize: 15,
                }}
              >
                {category}
              </button>
            );
          })}
        </div>

        {/* LOADING */}
        {loading ? (
          <div
            style={{
              textAlign: "center",
              padding: 60,
              color: "#64748b",
              fontWeight: 700,
            }}
          >
            Loading garments...
          </div>
        ) : filteredGarments.length === 0 ? (
          <div
            style={{
              background: "#fff",
              padding: 45,
              borderRadius: 20,
              textAlign: "center",
              border: "1px solid #dbe2ea",
              color: "#64748b",
            }}
          >
            No garments found.
          </div>
        ) : (
          <div
            style={{
              display: "grid",
              gridTemplateColumns:
                "repeat(auto-fit,minmax(240px,1fr))",
              gap: 20,
            }}
          >
            {filteredGarments.map((item) => {
              const image =
                item.thumbnailUrl || item.downloadUrl || "";

              const hasBuy =
                item.buyPrice !== null &&
                item.buyPrice !== undefined &&
                item.buyPrice !== "";

              const hasSale =
                item.salePrice !== null &&
                item.salePrice !== undefined &&
                item.salePrice !== "";

              return (
                <article
                  key={item.id}
                  style={{
                    background: "#fff",
                    borderRadius: 20,
                    overflow: "hidden",
                    border: "1px solid #dbe2ea",
                    boxShadow: "0 8px 28px rgba(15,23,42,.08)",
                    display: "flex",
                    flexDirection: "column",
                  }}
                >
                  {/* PRODUCT IMAGE */}
                  <div
                    style={{
                      position: "relative",
                      aspectRatio: "1 / 1",
                      background:
                        "linear-gradient(135deg,#f8edd7,#f1e1c5)",
                      overflow: "hidden",
                    }}
                  >
                    <div
                      style={{
                        position: "absolute",
                        top: 14,
                        left: 14,
                        zIndex: 2,
                        background: "#e11d68",
                        color: "#fff",
                        padding: "8px 14px",
                        borderRadius: 10,
                        fontWeight: 900,
                        fontSize: 16,
                        boxShadow: "0 4px 10px rgba(225,29,104,.25)",
                      }}
                    >
                      Sale
                    </div>

                    {image ? (
                      <img
                        src={image}
                        alt={item.title || "Garment"}
                        style={{
                          width: "100%",
                          height: "100%",
                          objectFit: "cover",
                          display: "block",
                        }}
                      />
                    ) : (
                      <div
                        style={{
                          width: "100%",
                          height: "100%",
                          display: "flex",
                          alignItems: "center",
                          justifyContent: "center",
                          fontSize: 100,
                        }}
                      >
                        👕
                      </div>
                    )}
                  </div>

                  {/* PRODUCT INFO */}
                  <div
                    style={{
                      padding: 18,
                      display: "flex",
                      flexDirection: "column",
                      flex: 1,
                    }}
                  >
                    <h2
                      style={{
                        margin: 0,
                        fontSize: 20,
                        lineHeight: 1.35,
                        minHeight: 54,
                      }}
                    >
                      {item.title || "Untitled Garment"}
                    </h2>

                    {item.description && (
                      <p
                        style={{
                          margin: "8px 0",
                          color: "#64748b",
                          lineHeight: 1.5,
                          fontSize: 14,
                        }}
                      >
                        {item.description}
                      </p>
                    )}

                    <div style={{ marginTop: "auto" }}>
                      {hasBuy && (
                        <div
                          style={{
                            color: "#64748b",
                            marginTop: 10,
                            textDecoration: hasSale
                              ? "line-through"
                              : "none",
                            fontSize: 15,
                          }}
                        >
                          Rs. {item.buyPrice}
                        </div>
                      )}

                      {hasSale && (
                        <div
                          style={{
                            color: "#059669",
                            fontSize: 22,
                            fontWeight: 900,
                            marginTop: 4,
                          }}
                        >
                          Rs. {item.salePrice}
                        </div>
                      )}

                      <Link
                        href={`/content/${item.id}`}
                        style={{
                          display: "block",
                          marginTop: 16,
                          padding: "14px 12px",
                          borderRadius: 12,
                          background:
                            "linear-gradient(90deg,#e11d68,#ec4899)",
                          color: "#fff",
                          textAlign: "center",
                          textDecoration: "none",
                          fontWeight: 900,
                          fontSize: 16,
                        }}
                      >
                        🛒 View Product & Order
                      </Link>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </section>
    </main>
  );
}
