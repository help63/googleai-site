*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:#05030d;color:#f7f5ff;font-family:Arial,Helvetica,sans-serif}
a{text-decoration:none;color:inherit}
.nav{height:78px;padding:0 6%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ffffff12;background:#070511cc;backdrop-filter:blur(20px);position:sticky;top:0;z-index:20}
.brand{display:flex;align-items:center;gap:10px;font-size:21px;font-weight:800}.brand span:last-child span{color:#a78bfa}
.logo{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(135deg,#8b5cf6,#ec4899);font-weight:900;box-shadow:0 0 30px #8b5cf655}
.navlinks{display:flex;gap:30px;color:#aaa5ba;font-size:14px}.navlinks a:hover{color:white}
.navbutton,.primary{background:linear-gradient(100deg,#7c3aed,#ec4899);padding:12px 19px;border-radius:12px;font-weight:700;box-shadow:0 10px 35px #8b5cf633}
.hero{min-height:730px;padding:100px 8%;display:flex;align-items:center;justify-content:space-between;gap:70px;position:relative;overflow:hidden}
.orb{position:absolute;border-radius:50%;filter:blur(80px);opacity:.25}.orb1{width:450px;height:450px;background:#7c3aed;top:-180px;left:-150px}.orb2{width:500px;height:500px;background:#ec4899;right:-180px;bottom:-180px}
.heroCopy{position:relative;z-index:2;max-width:680px}.pill,.sectionTitle span,.studioHead span,.security>div>span{font-size:11px;letter-spacing:2px;color:#b9a7ff;font-weight:800}.dot{display:inline-block;width:7px;height:7px;background:#34d399;border-radius:50%;margin-right:8px;box-shadow:0 0 12px #34d399}
h1{font-size:clamp(60px,8vw,105px);line-height:.91;letter-spacing:-6px;margin:28px 0}em{font-style:normal;background:linear-gradient(100deg,#a78bfa,#f472b6);-webkit-background-clip:text;color:transparent}
.heroCopy>p{font-size:19px;line-height:1.7;color:#aaa5ba;max-width:600px}.heroActions{display:flex;gap:14px;margin:35px 0}.primary,.secondary{padding:15px 23px;border-radius:13px}.secondary{border:1px solid #ffffff1a;background:#ffffff08}
.stats{display:flex;gap:45px;margin-top:45px}.stats b{font-size:27px}.stats small{display:block;color:#777286;margin-top:5px}
.heroCard{width:min(440px,100%);padding:15px;background:#ffffff0a;border:1px solid #ffffff16;border-radius:25px;box-shadow:0 40px 100px #0009;transform:rotate(2deg);position:relative;z-index:2}.cardTop{display:flex;justify-content:space-between;padding:12px;color:#aaa5ba;font-size:13px}.live{color:#34d399}.preview{height:390px;border-radius:18px;background:radial-gradient(circle at 50% 30%,#8b5cf655,#ec489922 30%,#090612 65%),linear-gradient(135deg,#171022,#08060e);display:grid;place-items:center;align-content:center;text-align:center}.spark{font-size:48px;color:#d8b4fe}.preview h3{font-size:42px;margin:5px}.preview p{color:#8f899d}.miniPrompt{margin-top:12px;padding:13px;background:#08060e;border:1px solid #ffffff12;border-radius:12px;display:flex;justify-content:space-between;color:#696375}.miniPrompt button{border:0;border-radius:8px;background:#8b5cf6;color:white}
.section{padding:110px 8%}.sectionTitle{text-align:center}.sectionTitle h2,.studio h2,.security h2{font-size:48px;letter-spacing:-2px;margin:14px 0 55px}
.featureGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.feature{padding:30px;border:1px solid #ffffff12;background:linear-gradient(145deg,#ffffff09,#ffffff03);border-radius:22px;min-height:230px;transition:.3s}.feature:hover{transform:translateY(-7px);border-color:#ffffff25}.featureIcon{font-size:27px;margin-bottom:30px}.feature h3{font-size:19px}.feature p{color:#8f899d;line-height:1.6;font-size:14px}.feature a{font-size:13px;color:#b9a7ff}.violet .featureIcon{color:#a78bfa}.pink .featureIcon{color:#f472b6}.cyan .featureIcon{color:#22d3ee}.blue .featureIcon{color:#60a5fa}
.studio{padding:100px 8%;background:linear-gradient(#090611,#05030d)}.studioHead{display:flex;justify-content:space-between;align-items:end}.studio h2{margin-bottom:35px}.provider{padding:9px 13px;border:1px solid #ffffff12;border-radius:99px;color:#34d399;font-size:12px}
.workspace{display:grid;grid-template-columns:1fr 1fr;gap:20px}.promptBox,.chatBox{border:1px solid #ffffff12;background:#ffffff07;border-radius:22px;padding:20px}.promptBox label{display:block;color:#aaa5ba;margin-bottom:12px}.promptBox textarea{width:100%;height:300px;resize:none;background:#05030d;border:1px solid #ffffff10;border-radius:15px;color:white;padding:17px;font:inherit;outline:none}.promptBottom{display:flex;align-items:center;justify-content:space-between;margin-top:15px;color:#777286;font-size:13px}.promptBottom button{border:0;background:linear-gradient(100deg,#7c3aed,#ec4899);color:white;padding:13px 18px;border-radius:11px;font-weight:bold}.chatHead{display:flex;gap:12px;align-items:center;border-bottom:1px solid #ffffff0d;padding-bottom:15px}.avatar{width:38px;height:38px;border-radius:12px;background:linear-gradient(135deg,#7c3aed,#ec4899);display:grid;place-items:center;font-weight:bold}.chatHead small{display:block;color:#777286;margin-top:3px}.messages{height:350px;overflow:auto;padding-top:15px}.msg{background:#ffffff08;border:1px solid #ffffff0b;border-radius:14px;padding:12px;margin:8px 0;color:#aaa5ba;font-size:14px;line-height:1.5}.msg.user{background:#4c1d9544;color:#eee;margin-left:35px}
.security{padding:100px 8%;display:grid;grid-template-columns:1fr 1fr;gap:60px;background:radial-gradient(circle at 20% 50%,#082f4955,transparent 40%)}.security h2{margin-bottom:20px}.security p{color:#9790a4;line-height:1.8;max-width:570px}.securityGrid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.securityGrid div{padding:24px;border:1px solid #ffffff10;border-radius:18px;background:#ffffff06;font-size:27px}.securityGrid b,.securityGrid small{display:block}.securityGrid b{font-size:15px;margin-top:18px}.securityGrid small{font-size:12px;color:#777286;margin-top:5px}
footer{border-top:1px solid #ffffff10;padding:45px 8%;display:grid;grid-template-columns:1fr auto;gap:30px}.footerBrand{display:flex;gap:14px;align-items:center}.footerBrand b{font-size:18px}.footerBrand p,.copyright{color:#6f697b;font-size:12px}.footerLinks{display:flex;gap:22px;color:#aaa5ba;font-size:13px}.footerLinks a:hover{color:white}.copyright{grid-column:1/-1;margin:10px 0 0}
@media(max-width:850px){.navlinks{display:none}.hero{padding-top:70px;flex-direction:column}.heroCard{width:100%}.featureGrid{grid-template-columns:1fr 1fr}.workspace,.security{grid-template-columns:1fr}.securityGrid{margin-top:20px}h1{letter-spacing:-4px}.stats{gap:20px}}
@media(max-width:550px){.featureGrid{grid-template-columns:1fr}.navbutton{display:none}.hero{padding-left:6%;padding-right:6%}.section,.studio,.security,footer{padding-left:6%;padding-right:6%}.heroActions{flex-direction:column}.heroActions a{text-align:center}.footerLinks{flex-wrap:wrap}}
