/* ===== 3D HERO ===== */

.hero-3d {
  position: relative;
  overflow: hidden;
  min-height: 300px;
  isolation: isolate;
  background:
    radial-gradient(circle at 20% 30%, #06b6d4 0, transparent 25%),
    radial-gradient(circle at 80% 25%, #ec4899 0, transparent 28%),
    radial-gradient(circle at 50% 90%, #7c3aed 0, transparent 38%),
    linear-gradient(135deg, #0f172a, #312e81 50%, #581c87);
  perspective: 900px;
}

.hero-3d::before {
  content: "";
  position: absolute;
  inset: -50%;
  background:
    repeating-linear-gradient(
      90deg,
      rgba(255,255,255,.05) 0,
      rgba(255,255,255,.05) 1px,
      transparent 1px,
      transparent 45px
    );
  transform: rotateX(65deg) translateY(35%);
  transform-origin: center;
  animation: heroGrid 10s linear infinite;
  z-index: -1;
}

.hero-3d-content {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: white;
  text-align: center;
  transform: translateZ(80px);
  text-shadow: 0 8px 25px rgba(0,0,0,.35);
}

