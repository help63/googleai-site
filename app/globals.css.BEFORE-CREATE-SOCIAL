* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: #f4f6f9;
  color: #172033;
  font-family: Arial, Helvetica, sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

.container {
  width: min(1180px, calc(100% - 30px));
  margin: auto;
}

.topbar {
  background: #101828;
  color: #dbe4f0;
  font-size: 13px;
}

.topbar-inner {
  display: flex;
  justify-content: space-between;
  padding: 9px 0;
}

.brand-row {
  min-height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  background: white;
}

.logo {
  font-size: 38px;
  font-weight: 900;
  letter-spacing: -2px;
  color: #111827;
}

.logo span {
  color: #7c3aed;
}

.search {
  display: flex;
  width: min(470px, 100%);
}

.search input {
  flex: 1;
  padding: 13px 15px;
  border: 1px solid #d8dee8;
  border-radius: 8px 0 0 8px;
  outline: none;
}

.search button {
  border: 0;
  padding: 0 20px;
  background: #7c3aed;
  color: white;
  font-weight: bold;
  border-radius: 0 8px 8px 0;
}

.nav {
  background: #fff;
  border-top: 1px solid #edf0f4;
  border-bottom: 1px solid #dfe4eb;
}

.nav-inner {
  display: flex;
  gap: 4px;
  overflow-x: auto;
}

.nav a {
  white-space: nowrap;
  padding: 14px 12px;
  font-size: 14px;
  font-weight: 700;
}

.nav a:hover {
  color: #7c3aed;
  background: #f5f3ff;
}

.ad-box {
  height: 90px;
  margin: 22px 0;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #fff;
  color: #9aa3b2;
  font-size: 11px;
  letter-spacing: 1px;
  border: 1px solid #edf0f4;
}

.breaking {
  display: flex;
  gap: 15px;
  align-items: center;
  background: #fff;
  padding: 12px 16px;
  border-left: 5px solid #ef4444;
  margin-bottom: 18px;
}

.breaking strong {
  color: #ef4444;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.45fr 1fr;
  gap: 18px;
}

.lead-card,
.news-card,
.section {
  background: white;
  border: 1px solid #e3e7ed;
  border-radius: 12px;
}

.lead-card {
  overflow: hidden;
}

.placeholder-image {
  height: 260px;
  display: grid;
  place-items: center;
  font-size: 80px;
  background: linear-gradient(135deg, #312e81, #7c3aed, #ec4899);
}

.lead-card h1,
.lead-card p,
.lead-card .category,
.lead-card .read-more {
  margin-left: 22px;
  margin-right: 22px;
}

.category {
  display: inline-block;
  color: #7c3aed;
  font-size: 12px;
  font-weight: bold;
  margin-top: 18px;
}

.lead-card h1 {
  font-size: 29px;
  line-height: 1.35;
}

.lead-card p {
  color: #667085;
  line-height: 1.7;
}

.read-more {
  display: inline-block;
  margin-bottom: 22px;
  color: #7c3aed;
  font-weight: bold;
}

.side-news {
  display: grid;
  gap: 14px;
}

.news-card {
  padding: 15px;
  display: flex;
  gap: 15px;
}

.thumb {
  width: 82px;
  height: 82px;
  flex: 0 0 82px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  background: #f0eaff;
  font-size: 32px;
}

.news-card h2 {
  font-size: 17px;
  line-height: 1.4;
  margin: 5px 0;
}

.news-card small,
.latest-list small {
  color: #98a2b3;
}

.news-card a {
  color: #7c3aed;
  font-size: 13px;
  font-weight: bold;
}

.section {
  margin: 22px 0;
  padding: 22px;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 2px solid #f0f2f5;
  padding-bottom: 12px;
  margin-bottom: 18px;
}

.section-title h2 {
  margin: 0;
}

.section-title a {
  color: #7c3aed;
  font-weight: bold;
}

.feature-grid,
.tool-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 13px;
}

.feature-grid a,
.tool-grid a {
  padding: 22px 15px;
  text-align: center;
  border-radius: 10px;
  background: #f8f7ff;
  border: 1px solid #e7e1ff;
  font-weight: 700;
}

.feature-grid a:hover,
.tool-grid a:hover {
  background: #ede9fe;
}

.latest-list {
  display: grid;
  gap: 4px;
}

.latest-list article {
  display: flex;
  gap: 18px;
  padding: 15px 5px;
  border-bottom: 1px solid #edf0f4;
}

.latest-list article > span {
  color: #7c3aed;
  font-size: 21px;
  font-weight: 900;
}

.latest-list h3 {
  margin: 0 0 5px;
  font-size: 17px;
}

.studio {
  padding: 38px;
  border-radius: 14px;
  color: white;
  background: linear-gradient(120deg, #111827, #312e81, #7c3aed);
}

.studio span {
  color: #c4b5fd;
  font-size: 12px;
  font-weight: bold;
}

.studio h2 {
  font-size: 32px;
  margin: 10px 0;
}

.studio p {
  color: #ddd6fe;
  max-width: 650px;
  line-height: 1.7;
}

.studio a {
  display: inline-block;
  margin-top: 10px;
  padding: 12px 18px;
  background: white;
  color: #4c1d95;
  border-radius: 8px;
  font-weight: bold;
}

footer {
  background: #101828;
  color: white;
  margin-top: 35px;
}

.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 50px;
  padding: 45px 0;
}

.footer-grid p {
  color: #98a2b3;
}

.footer-grid a {
  display: block;
  color: #cbd5e1;
  margin: 9px 0;
}

.copyright {
  border-top: 1px solid #263244;
  padding: 18px;
  text-align: center;
  color: #98a2b3;
  font-size: 13px;
}

@media (max-width: 800px) {
  .brand-row {
    flex-direction: column;
    padding: 18px 0;
    gap: 15px;
  }

  .search {
    width: 100%;
  }

  .topbar-inner {
    display: none;
  }

  .hero-grid {
    grid-template-columns: 1fr;
  }

  .feature-grid,
  .tool-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .footer-grid {
    grid-template-columns: 1fr;
    gap: 15px;
  }

  .lead-card h1 {
    font-size: 23px;
  }
}

@media (max-width: 480px) {
  .container {
    width: min(100% - 18px, 1180px);
  }

  .feature-grid,
  .tool-grid {
    grid-template-columns: 1fr;
  }

  .placeholder-image {
    height: 190px;
  }

  .section {
    padding: 15px;
  }
}

.live-info {
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
  font-size: 12px;
}

.breaking-scroll {
  display: flex;
  gap: 30px;
  overflow: hidden;
  white-space: nowrap;
  flex: 1;
}

.breaking-scroll span {
  color: #475467;
}

.section-subtitle {
  margin: 5px 0 0;
  color: #667085;
  font-size: 14px;
}

.marketplace {
  border-top: 4px solid #7c3aed;
}

.market-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 13px;
}

.market-grid a {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 125px;
  padding: 20px;
  border: 1px solid #e4e7ec;
  border-radius: 12px;
  background: #fafafa;
  transition: .2s;
}

.market-grid a:hover {
  transform: translateY(-3px);
  background: #f5f3ff;
  border-color: #c4b5fd;
}

.market-grid strong {
  font-size: 35px;
  margin-bottom: 10px;
}

.garment-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.product-card {
  border: 1px solid #e4e7ec;
  border-radius: 12px;
  overflow: hidden;
  background: white;
  padding-bottom: 18px;
}

.product-image {
  height: 190px;
  display: grid;
  place-items: center;
  font-size: 75px;
  background: linear-gradient(
    135deg,
    #ede9fe,
    #fce7f3
  );
}

.product-card h3,
.product-card p,
.product-card span,
.product-card button {
  margin-left: 18px;
  margin-right: 18px;
}

.product-card span {
  display: block;
  color: #7c3aed;
  font-size: 12px;
  font-weight: bold;
  margin-top: 15px;
}

.product-card h3 {
  margin-top: 7px;
  margin-bottom: 7px;
}

.product-card p {
  color: #667085;
  font-size: 14px;
  line-height: 1.5;
}

.product-card button {
  border: 0;
  background: #7c3aed;
  color: white;
  padding: 10px 15px;
  border-radius: 7px;
  font-weight: bold;
}

@media (max-width: 800px) {

  .topbar-inner {
    flex-direction: column;
    gap: 8px;
  }

  .brand-row {
    flex-direction: column;
    padding: 18px 0;
  }

  .market-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .garment-grid {
    grid-template-columns: 1fr;
  }

}



/* ===== GoogleAi 3D COLORFUL UI ===== */

:root {
  --g-blue: #4285f4;
  --g-purple: #8b5cf6;
  --g-pink: #ec4899;
  --g-cyan: #06b6d4;
  --g-green: #22c55e;
  --g-bg: #070b1a;
  --g-card: rgba(255,255,255,.075);
  --g-border: rgba(255,255,255,.14);
}

html {
  scroll-behavior: smooth;
}

body {
  background:
    radial-gradient(circle at 10% 10%, rgba(66,133,244,.22), transparent 30%),
    radial-gradient(circle at 90% 15%, rgba(139,92,246,.20), transparent 28%),
    radial-gradient(circle at 50% 90%, rgba(6,182,212,.15), transparent 32%),
    var(--g-bg) !important;
  color: #fff;
  overflow-x: hidden;
}

/* colorful ambient glow */

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: -1;
  background:
    linear-gradient(
      120deg,
      rgba(66,133,244,.08),
      transparent 35%,
      rgba(236,72,153,.07),
      transparent 70%,
      rgba(6,182,212,.08)
    );
}

/* Header */

.site-header {
  background: rgba(7,11,26,.72) !important;
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
  border-bottom: 1px solid var(--g-border);
  box-shadow: 0 10px 40px rgba(0,0,0,.25);
}

/* Logo */

.logo {
  background: linear-gradient(
    90deg,
    #4285f4,
    #8b5cf6,
    #ec4899,
    #06b6d4
  );
  background-size: 300% auto;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent !important;
  animation: gradientFlow 6s linear infinite;
  filter: drop-shadow(0 0 15px rgba(99,102,241,.35));
}

.logo span {
  color: transparent !important;
}

/* Sections */

.section {
  position: relative;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 28px;
  padding: 28px;
  margin: 28px auto;
  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.085),
      rgba(255,255,255,.025)
    );
  box-shadow:
    0 25px 70px rgba(0,0,0,.30),
    inset 0 1px 0 rgba(255,255,255,.08);
  backdrop-filter: blur(18px);
  transform: translateZ(0);
}

/* Section title */

.section-title h2 {
  background: linear-gradient(90deg,#60a5fa,#a78bfa,#f472b6);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent !important;
}

/* Cards / grids */

.tool-grid > *,
.feature-grid > *,
.latest-list > *,
article {
  border: 1px solid var(--g-border);
  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.10),
      rgba(255,255,255,.035)
    ) !important;
  border-radius: 22px;
  box-shadow:
    0 15px 35px rgba(0,0,0,.25),
    inset 0 1px 0 rgba(255,255,255,.08);
  transition:
    transform .3s ease,
    box-shadow .3s ease,
    border-color .3s ease;
}

.tool-grid > *:hover,
.feature-grid > *:hover,
.latest-list > *:hover,
article:hover {
  transform: translateY(-8px) scale(1.015);
  border-color: rgba(96,165,250,.5);
  box-shadow:
    0 25px 55px rgba(66,133,244,.20),
    0 0 35px rgba(139,92,246,.12),
    inset 0 1px 0 rgba(255,255,255,.15);
}

/* AI Image Generator */

.ai-image-generator {
  position: relative;
  overflow: hidden;
  padding: 24px;
  border-radius: 26px;
  border: 1px solid rgba(139,92,246,.35);
  background:
    linear-gradient(
      135deg,
      rgba(66,133,244,.16),
      rgba(139,92,246,.13),
      rgba(236,72,153,.10),
      rgba(6,182,212,.10)
    );
  box-shadow:
    0 25px 70px rgba(79,70,229,.20),
    inset 0 1px 0 rgba(255,255,255,.12);
}

.ai-image-generator::before {
  content: "";
  position: absolute;
  width: 180px;
  height: 180px;
  right: -70px;
  top: -80px;
  border-radius: 50%;
  background: rgba(236,72,153,.25);
  filter: blur(35px);
  pointer-events: none;
}

.ai-image-generator h3 {
  position: relative;
  color: #fff !important;
  font-size: 1.35rem;
  margin-bottom: 16px;
}

/* Inputs */

.ai-image-generator textarea,
.search input,
input,
textarea {
  border: 1px solid rgba(255,255,255,.14) !important;
  background: rgba(0,0,0,.28) !important;
  color: #fff !important;
  border-radius: 16px !important;
  outline: none;
  transition: .25s ease;
}

.ai-image-generator textarea {
  width: 100%;
  min-height: 120px;
  padding: 16px;
  resize: vertical;
}

.ai-image-generator textarea:focus,
.search input:focus,
input:focus,
textarea:focus {
  border-color: #8b5cf6 !important;
  box-shadow:
    0 0 0 3px rgba(139,92,246,.15),
    0 0 25px rgba(66,133,244,.15);
}

/* Buttons */

button,
.ai-image-generator button {
  border: 0 !important;
  border-radius: 15px !important;
  padding: 12px 22px;
  color: white !important;
  font-weight: 700;
  cursor: pointer;
  background:
    linear-gradient(
      135deg,
      #4285f4,
      #7c3aed 48%,
      #ec4899
    ) !important;
  box-shadow:
    0 10px 25px rgba(99,102,241,.30),
    inset 0 1px 0 rgba(255,255,255,.25);
  transition: transform .2s ease, box-shadow .2s ease;
}

button:hover,
.ai-image-generator button:hover {
  transform: translateY(-3px);
  box-shadow:
    0 16px 35px rgba(139,92,246,.40),
    0 0 25px rgba(236,72,153,.15);
}

button:disabled,
.ai-image-generator button:disabled {
  opacity: .6;
  cursor: wait;
  transform: none;
}

/* Generated image */

.generated-image {
  margin-top: 20px;
  padding: 12px;
  border-radius: 22px;
  background: rgba(0,0,0,.25);
  border: 1px solid rgba(255,255,255,.12);
  box-shadow: 0 25px 60px rgba(0,0,0,.35);
}

.generated-image img {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 16px;
  box-shadow: 0 20px 45px rgba(0,0,0,.35);
}

/* Advertisement */

.ad-box {
  border: 1px dashed rgba(255,255,255,.18) !important;
  border-radius: 18px;
  background: rgba(255,255,255,.025) !important;
  color: rgba(255,255,255,.45);
}

/* Links */

a {
  transition: color .2s ease, transform .2s ease;
}

a:hover {
  color: #93c5fd;
}

/* 3D floating animation */

@keyframes gradientFlow {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@media (prefers-reduced-motion: no-preference) {
  .ai-image-generator {
    animation: cardFloat 6s ease-in-out infinite;
  }

  @keyframes cardFloat {
    0%,100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }
}

/* Mobile */

@media (max-width: 700px) {
  .section {
    border-radius: 20px;
    padding: 18px;
    margin: 18px auto;
  }

  .ai-image-generator {
    padding: 18px;
    border-radius: 20px;
  }

  .tool-grid > *,
  .feature-grid > * {
    border-radius: 18px;
  }
}

