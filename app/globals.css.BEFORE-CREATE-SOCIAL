/* =========================================================
   GOOGLEAI FIXED TOP BAR + PRIVATE CREATE BOX
   ========================================================= */

.site-header {
  position: sticky;
  top: 0;
  z-index: 9999;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 10000;
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

/* Keep GoogleAi identity and live time visible */
.site-header .container,
.site-header .topbar .container {
  min-height: 54px;
}

/* Private opt-in Create panel */
.create-follow-box {
  position: sticky;
  top: 70px;
  z-index: 100;
  margin: 12px;
  padding: 16px 12px;
  border-radius: 20px;
  background:
    linear-gradient(145deg, rgba(125,70,255,.95), rgba(0,190,255,.85));
  color: #fff;
  box-shadow:
    0 15px 35px rgba(0,0,0,.30),
    inset 0 1px 0 rgba(255,255,255,.25);
  text-align: center;
}

.create-follow-icon {
  font-size: 28px;
  margin-bottom: 4px;
}

.create-follow-box strong {
  display: block;
  font-size: 18px;
}

.create-follow-box > span {
  display: block;
  margin: 4px 0 10px;
  font-size: 11px;
  opacity: .9;
}

.create-follow-box form {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.create-follow-box input {
  width: 100%;
  box-sizing: border-box;
  border: 0;
  outline: none;
  border-radius: 10px;
  padding: 9px 10px;
  background: rgba(255,255,255,.96);
  color: #111827;
}

.create-follow-box button {
  border: 0;
  border-radius: 10px;
  padding: 9px;
  cursor: pointer;
  font-weight: 800;
  background: #fff;
  color: #6d28d9;
  transition: transform .2s ease;
}

.create-follow-box button:hover {
  transform: translateY(-2px);
}

.create-follow-box small {
  display: block;
  margin-top: 9px;
  font-size: 9px;
  line-height: 1.3;
  opacity: .8;
}

@media (max-width: 700px) {
  .site-header {
    position: sticky;
    top: 0;
  }

  .create-follow-box {
    position: relative;
    top: auto;
  }
}

