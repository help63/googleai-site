  box-shadow:
    0 20px 45px rgba(0,0,0,.3),
    inset 0 1px rgba(255,255,255,.35);
  backdrop-filter: blur(12px);
  animation: heroFloat 4s ease-in-out infinite;
}

.hero-3d-content strong {
  font-size: 32px;
