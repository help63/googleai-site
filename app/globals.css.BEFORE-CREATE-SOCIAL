  box-shadow: 0 10px 25px rgba(124,58,237,.25);
  transition: transform .2s ease, box-shadow .2s ease;
}

.ai-image-generator button:hover {
  transform: translateY(-2px);
  box-shadow: 0 15px 30px rgba(124,58,237,.35);
}

.ai-image-generator button:disabled {
  opacity: .65;
  cursor: wait;
}

.generated-image img {
  box-shadow: 0 25px 60px rgba(15,23,42,.20);
}

@media (max-width: 700px) {
  .container {
    width: calc(100% - 20px);
  }

  .logo {
    font-size: 32px;
  }

  .section {
    padding: 18px;
  }

  .studio {
    padding: 24px 18px;
  }

  .studio h2 {
    font-size: 27px;
  }

  .ai-image-generator {
    padding: 16px;
  }
}

/* ===== GOOGLEAI COLORFUL 3D TOOLBOX ===== */

.toolbox-section {
  max-width: 1200px;
  margin: 35px auto;
  padding: 24px;
}

.toolbox-title {
  text-align: center;
  font-size: clamp(30px,5vw,52px);
  font-weight: 900;
  background: linear-gradient(90deg,#ff0080,#7928ca,#00c6ff,#00e676);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.toolbox-subtitle {
  text-align: center;
  opacity: .75;
  margin-bottom: 28px;
}

.toolbox-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(150px,1fr));
  gap: 18px;
}

.toolbox-card {
  min-height: 145px;
  padding: 20px;
  border-radius: 25px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: white;
  text-decoration: none;
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.25);
  box-shadow: 0 15px 35px rgba(0,0,0,.22);
  transition: .3s ease;
}

.toolbox-card:nth-child(4n+1) {
  background: linear-gradient(145deg,#ff416c,#ff4b2b);
}
.toolbox-card:nth-child(4n+2) {
  background: linear-gradient(145deg,#4776e6,#8e54e9);
}
.toolbox-card:nth-child(4n+3) {
  background: linear-gradient(145deg,#00b09b,#96c93d);
}
.toolbox-card:nth-child(4n+4) {
  background: linear-gradient(145deg,#f7971e,#ffd200);
}

.toolbox-card:hover {
  transform: translateY(-10px) scale(1.03) rotateX(4deg);
  box-shadow: 0 25px 55px rgba(0,0,0,.35);
}

.toolbox-icon {
  font-size: 42px;
  margin-bottom: 10px;
  filter: drop-shadow(0 7px 6px rgba(0,0,0,.25));
}

.toolbox-card strong {
  font-size: 17px;
}

.toolbox-card small {
  margin-top: 5px;
  opacity: .85;
}

.screensaver {
  height: 190px;
  margin-top: 35px;
  border-radius: 30px;
  overflow: hidden;
  position: relative;
  background:
    radial-gradient(circle at 20% 30%,#ff0080,transparent 25%),
    radial-gradient(circle at 80% 70%,#00c6ff,transparent 25%),
    linear-gradient(135deg,#111827,#312e81);
  box-shadow: 0 25px 70px rgba(0,0,0,.3);
}

.screensaver::before,
.screensaver::after {
  content: "";
  position: absolute;
  width: 180px;
  height: 180px;
  border-radius: 50%;
  background: rgba(255,255,255,.14);
  filter: blur(8px);
  animation: googleAiFloat 7s infinite alternate ease-in-out;
}

.screensaver::after {
  right: 10%;
  bottom: -70px;
  animation-delay: -3s;
}

.screensaver-content {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 28px;
  position: relative;
  z-index: 2;
}

.screensaver-content span {
  font-size: 15px;
  opacity: .8;
  margin-top: 8px;
}

@keyframes googleAiFloat {
  from {
    transform: translate(0,0) scale(1);
  }
  to {
    transform: translate(140px,-40px) scale(1.4);
  }
}

@media (max-width:600px) {
  .toolbox-section {
    padding: 12px;
  }

  .toolbox-grid {
    grid-template-columns: repeat(2,1fr);
    gap: 12px;
  }

  .toolbox-card {
    min-height: 125px;
    padding: 12px 7px;
  }

  .toolbox-icon {
    font-size: 34px;
  }
}



