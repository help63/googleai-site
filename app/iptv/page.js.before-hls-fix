"use client";

import { useEffect, useMemo, useState } from "react";

export default function IPTVPage() {
  const [channels, setChannels] = useState([]);
  const [active, setActive] = useState(null);
  const [search, setSearch] = useState("");
  const [category, setCategory] = useState("All");
  const [favorites, setFavorites] = useState([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    try {
      setFavorites(
        JSON.parse(localStorage.getItem("iptv_favorites") || "[]")
      );
    } catch {}

    fetch("/api/iptv")
      .then((res) => res.json())
      .then((data) => {
        if (data.success) {
          setChannels(
            (data.channels || []).filter(
              (channel) => channel.enabled !== false
            )
          );
        }
      })
      .catch(console.error)
      .finally(() => setLoading(false));
  }, []);

  const categories = [
    "All",
    ...new Set(
      channels.map((channel) => channel.category || "General")
    ),
  ];

  const filtered = useMemo(() => {
    const q = search.toLowerCase().trim();

    return channels.filter((channel) => {
      const matchesSearch =
        !q || channel.name?.toLowerCase().includes(q);

      const matchesCategory =
        category === "All" ||
        (channel.category || "General") === category;

      return matchesSearch && matchesCategory;
    });
  }, [channels, search, category]);

  function toggleFavorite(id) {
    const next = favorites.includes(id)
      ? favorites.filter((x) => x !== id)
      : [...favorites, id];

    setFavorites(next);
    localStorage.setItem(
      "iptv_favorites",
      JSON.stringify(next)
    );
  }

  useEffect(() => {
    if (!active) return;

    const video = document.getElementById("iptv-player");
    if (!video) return;

    const url = active.streamUrl || "";

    if (url.includes(".m3u8") && Hls.isSupported()) {
      const hls = new Hls({
        enableWorker: true,
      });

      hls.loadSource(url);
      hls.attachMedia(video);

      return () => {
        hls.destroy();
      };
    }

    if (video.canPlayType("application/vnd.apple.mpegurl")) {
      video.src = url;
    } else {
      video.src = url;
    }
  }, [active]);

  return (
    <main
      style={{
        minHeight: "100vh",
        padding: 24,
        maxWidth: 1200,
        margin: "auto",
      }}
    >
      <h1>📺 IPTV</h1>
      <p>Live TV Channels</p>

      <input
        type="search"
        value={search}
        onChange={(e) => setSearch(e.target.value)}
        placeholder="🔎 Search channel..."
        style={{
          width: "100%",
          boxSizing: "border-box",
          padding: 14,
          margin: "20px 0",
          borderRadius: 10,
          border: "1px solid #ccc",
          fontSize: 16,
        }}
      />

      <div
        style={{
          display: "flex",
          gap: 8,
          flexWrap: "wrap",
          marginBottom: 20,
        }}
      >
        {categories.map((item) => (
          <button
            key={item}
            onClick={() => setCategory(item)}
            style={{
              padding: "9px 14px",
              borderRadius: 20,
              border: "1px solid #ccc",
              cursor: "pointer",
              fontWeight: category === item ? "bold" : "normal",
            }}
          >
            {item}
          </button>
        ))}
      </div>

      {active && (
        <section style={{ marginBottom: 25 }}>
          <h2>{active.name}</h2>

          <div
            style={{
              width: "100%",
              aspectRatio: "16 / 9",
              background: "#000",
              borderRadius: 12,
              overflow: "hidden",
            }}
          >
            <video
              id="iptv-player"
              controls
              autoPlay
              playsInline
              style={{
                width: "100%",
                height: "100%",
              }}
            />
          </div>
        </section>
      )}

      {loading ? (
        <p>Loading channels...</p>
      ) : filtered.length === 0 ? (
        <p>No live channels available.</p>
      ) : (
        <div
          style={{
            display: "grid",
            gridTemplateColumns:
              "repeat(auto-fill,minmax(220px,1fr))",
            gap: 16,
          }}
        >
          {filtered.map((channel) => (
            <button
              key={channel.id}
              onClick={() => setActive(channel)}
              style={{
                textAlign: "left",
                padding: 16,
                borderRadius: 12,
                border: "1px solid #ddd",
                cursor: "pointer",
                background: "transparent",
              }}
            >
              {channel.logo ? (
                <img
                  src={channel.logo}
                  alt={channel.name}
                  style={{
                    width: "100%",
                    height: 110,
                    objectFit: "contain",
                    marginBottom: 10,
                  }}
                />
              ) : (
                <div
                  style={{
                    height: 110,
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    fontSize: 45,
                  }}
                >
                  📺
                </div>
              )}

              <h3>{channel.name}</h3>
              <span>🔴 Watch Live</span>

              <span
                role="button"
                tabIndex={0}
                onClick={(e) => {
                  e.stopPropagation();
                  toggleFavorite(channel.id);
                }}
                style={{
                  display: "block",
                  marginTop: 10,
                  cursor: "pointer",
                  fontSize: 20,
                }}
              >
                {favorites.includes(channel.id) ? "⭐" : "☆"} Favorite
              </span>
            </button>
          ))}
        </div>
      )}
    </main>
  );
}
