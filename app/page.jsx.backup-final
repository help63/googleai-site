"use client";

import { useState } from "react";

export default function Home() {
  const [prompt, setPrompt] = useState("");
  const [type, setType] = useState("chat");
  const [quality, setQuality] = useState("HD");
  const [loading, setLoading] = useState(false);
  const [result, setResult] = useState(null);
  const [error, setError] = useState("");

  async function generate() {
    if (!prompt.trim() || loading) return;

    setLoading(true);
    setError("");
    setResult(null);

    try {
      const response = await fetch("/api/generate", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          prompt,
          type,
          quality,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || "Generation failed.");
      }

      setResult(data);
    } catch (err) {
      setError(err.message || "Something went wrong.");
    } finally {
      setLoading(false);
    }
  }

  return (
    <main>
      <nav className="nav">
        <div className="brand">
          <span className="logo">G</span>
          <span>Google<span>Ai</span></span>
        </div>

        <div className="navlinks">
          <a href="#features">Features</a>
          <a href="#studio">Studio</a>
          <a href="#admin">Admin</a>
          <a href="#contact">Contact</a>
        </div>

        <a className="navbutton" href="#studio">
          Launch Studio →
        </a>
      </nav>

      <section className="hero">
        <div className="orb orb1" />
        <div className="orb orb2" />

        <div className="heroCopy">
          <div className="pill">
            <span className="dot" />
            NEXT-GEN AI CREATIVE STUDIO
          </div>

          <h1>
            Create without
            <br />
            <em>limits.</em>
          </h1>

          <p>
            Chat with AI, create images from prompts and build
            AI video workflows from one beautiful workspace.
          </p>

          <div className="heroActions">
            <a className="primary" href="#studio">
              Start Creating ✦
            </a>
            <a className="secondary" href="#features">
              Explore Features
            </a>
          </div>

          <div className="stats">
            <div><b>AI</b><small>Creative Studio</small></div>
            <div><b>4K</b><small>Video UI</small></div>
            <div><b>∞</b><small>Ideas</small></div>
          </div>
        </div>

        <div className="heroCard">
          <div className="cardTop">
            <span>GoogleAi Studio</span>
            <span className="live">● ONLINE</span>
          </div>

          <div className="preview">
            <div className="spark">✦</div>
            <h3>Imagine.</h3>
            <p>Turn your ideas into creations.</p>
          </div>

          <div className="miniPrompt">
            <span>Describe your idea...</span>
            <button>↑</button>
          </div>
        </div>
      </section>

      <section id="features" className="section">
        <div className="sectionTitle">
          <span>AI CREATIVE TOOLS</span>
          <h2>Everything you need to <em>create.</em></h2>
        </div>

        <div className="featureGrid">
          <Feature
            icon="✦"
            title="AI Image"
            text="Generate images from natural-language prompts."
            color="violet"
          />

          <Feature
            icon="▶"
            title="AI Video"
            text="Prepare prompts for supported Google video models."
            color="pink"
          />

          <Feature
            icon="⌘"
            title="AI Chat"
            text="Ask questions and work with a conversational AI."
            color="cyan"
          />

          <Feature
            icon="👑"
            title="Admin Studio"
            text="Separate administration and quota controls."
            color="blue"
          />
        </div>
      </section>

      <section id="studio" className="studio">
        <div className="studioHead">
          <div>
            <span>AI WORKSPACE</span>
            <h2>Prompt → <em>Creation</em></h2>
          </div>

          <div className="provider">
            ● Gemini Connected
          </div>
        </div>

        <div className="workspace">
          <div className="promptBox">
            <label>What do you want to create?</label>

            <div className="toolTabs">
              <button
                className={type === "chat" ? "active" : ""}
                onClick={() => setType("chat")}
              >
                💬 Chat
              </button>

              <button
                className={type === "image" ? "active" : ""}
                onClick={() => setType("image")}
              >
                🖼️ Image
              </button>

              <button
                className={type === "video" ? "active" : ""}
                onClick={() => setType("video")}
              >
                🎬 Video
              </button>
            </div>

            <textarea
              value={prompt}
              onChange={(e) => setPrompt(e.target.value)}
              placeholder={
                type === "image"
                  ? "Example: A cinematic futuristic city at sunset..."
                  : type === "video"
                  ? "Example: A cinematic drone shot over a futuristic city..."
                  : "Ask GoogleAi anything..."
              }
            />

            {type === "video" && (
              <div className="quality">
                <span>Video quality</span>

                <select
                  value={quality}
                  onChange={(e) => setQuality(e.target.value)}
                >
                  <option>540p</option>
                  <option>720p</option>
                  <option>HD</option>
                  <option>2K</option>
                  <option>4K</option>
                </select>
              </div>
            )}

            <div className="promptBottom">
              <span>
                {type === "chat"
                  ? "AI Chat"
                  : type === "image"
                  ? "Image generation"
                  : "Video workflow"}
              </span>

              <button onClick={generate} disabled={loading}>
                {loading ? "Creating..." : "Generate ✦"}
              </button>
            </div>
          </div>

          <div className="chatBox">
            <div className="chatHead">
              <span className="avatar">G</span>

              <div>
                <b>GoogleAi</b>
                <small>Creative Assistant</small>
              </div>
            </div>

            <div className="messages">
              {!result && !error && (
                <div className="msg">
                  ✦ Your generated result will appear here.
                </div>
              )}

              {loading && (
                <div className="msg">
                  ✨ AI is processing your request...
                </div>
              )}

              {error && (
                <div className="msg error">
                  ⚠️ {error}
                </div>
              )}

              {result?.type === "chat" && (
                <div className="msg">
                  {result.text}
                </div>
              )}

              {result?.type === "image" && (
                <div className="resultImage">
                  <img
                    src={`data:${result.mimeType};base64,${result.data}`}
                    alt="AI generated"
                  />

                  <a
                    className="download"
                    download="googleai-image.png"
                    href={`data:${result.mimeType};base64,${result.data}`}
                  >
                    Download Image ↓
                  </a>
                </div>
              )}

              {result?.type === "video" && (
                <div className="msg">
                  🎬 Video request prepared.
                  <br />
                  Quality: {quality}
                </div>
              )}
            </div>
          </div>
        </div>
      </section>

      <section id="admin" className="admin">
        <div>
          <span>ADMIN CONTROL</span>
          <h2>Your private <em>AI Studio.</em></h2>

          <p>
            Admin controls can be connected to authentication,
            user quotas and provider usage limits.
          </p>
        </div>

        <div className="adminCards">
          <div>
            👑
            <b>Admin Access</b>
            <small>Private dashboard</small>
          </div>

          <div>
            📊
            <b>User Quotas</b>
            <small>Manage usage limits</small>
          </div>

          <div>
            🎬
            <b>Video Controls</b>
            <small>Provider and quality settings</small>
          </div>

          <div>
            🔐
            <b>Secure API</b>
            <small>Keys stay server-side</small>
          </div>
        </div>
      </section>

      <footer id="contact">
        <div className="footerBrand">
          <span className="logo">G</span>

          <div>
            <b>GoogleAi</b>
            <p>Creative AI Studio</p>
          </div>
        </div>

        <div className="footerLinks">
          <a href="mailto:aliahmadoffcial63@gmail.com">Email</a>
          <a
            href="https://www.facebook.com/share/19MYBW49gw/"
            target="_blank"
          >
            Facebook
          </a>
          <a
            href="https://whatsapp.com/channel/0029VbChz5W3LdQQ5lER872s"
            target="_blank"
          >
            WhatsApp
          </a>
          <a href="tel:+923317867138">Contact</a>
        </div>

        <div className="copyright">
          © 2026 GoogleAi. All rights reserved.
        </div>
      </footer>
    </main>
  );
}

function Feature({ icon, title, text, color }) {
  return (
    <article className={`feature ${color}`}>
      <div className="featureIcon">{icon}</div>
      <h3>{title}</h3>
      <p>{text}</p>
      <a href="#studio">Open tool →</a>
    </article>
  );
}0
